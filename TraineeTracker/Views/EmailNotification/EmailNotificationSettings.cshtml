@model TraineeTracker.Models.Dtos.EmailNotificationSettingDto

@{
    ViewData["Title"] = "Notification Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/EmailNotificationSettings_temp.css"/>
    
}

@{
    var isTrainee = User.IsInRole("Trainee");
    var notifyLessonText = isTrainee
    ? "Notify me when one of my lessons is marked as "
    : "Notify me when any lesson is marked as ";

    var notifyPlanText = isTrainee
    ? "Notify me when my teaching plan is updated (includes a list of added and removed lessons)"
    : "Notify me when a trainee's teaching plan is updated (includes a list of added and removed lessons specific to that trainee)";



    var notifyFeedbackText = isTrainee
    ? "Notify me when my feedback is edited by a mentor or admin"
    : "Notify me when a trainee's feedback is edited (not recommended, since the feedback will reappear as unread anyway)";

}

<div class="sopro-grid-settings">
    <div class="sopro-card small-header">
        <div class="header thiccboi">Configure your email notification preferences here ...</div>

        <form id="notificationSettings" asp-action="SaveEmailNotificationSettingChange" method="post"
            class="sopro-inner-card flex">
            <!-- Alle Label-Checkboxen wie vorher -->
            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveSkippedNotifications" />
                @notifyLessonText&nbsp; <span class="sopro-tag skipped">Skipped</span>
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveOpenNotifications" />
                @notifyLessonText&nbsp; <span class="sopro-tag open">Open</span>
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveStartedNotifications" />
                @notifyLessonText&nbsp; <span class="sopro-tag started">Started</span>
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveFinishedNotifications" />
                @notifyLessonText&nbsp; <span class="sopro-tag finished">Finished</span>
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveRejectedNotifications" />
                @notifyLessonText&nbsp; <span class="sopro-tag rejected">Rejected</span>
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveAcceptedNotifications" />
                @notifyLessonText&nbsp; <span class="sopro-tag accepted">Accepted</span>
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveRatedNotifications" />
                @notifyLessonText&nbsp; <span class="sopro-tag rated">Rated</span>
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveImportChangeNotifications" />
                @notifyPlanText
            </label>

            <label class="status-label">
                <input type="checkbox" asp-for="ReceiveFeedbackChangeNotifications" />
                @notifyFeedbackText
            </label>

            <button id="saveNotificationsButton" type="submit" class="button mt-3"
                style="border-radius: 11px; background-color: #e61d47; font-weight: 900;">Save Settings</button>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("notificationSettings");
        const saveButton = document.getElementById("saveNotificationsButton");

        form.addEventListener("submit", function (event) {
            event.preventDefault();
            saveButton.classList.add("animate-spin");

            const rect = saveButton.getBoundingClientRect();
            const x = (rect.left + rect.width / 2) / window.innerWidth;
            const y = (rect.top + rect.height / 2) / window.innerHeight;

            for (let i = 0; i < 3; i++) {
                setTimeout(() => {
                    confetti({
                        particleCount: 50,
                        spread: 60,
                        startVelocity: 35,
                        origin: { x, y }
                    });
                }, i * 150);
            }

            setTimeout(() => {
                saveButton.classList.remove("animate-spin");
                form.submit();
            }, 1200);
        });
    });
</script>
