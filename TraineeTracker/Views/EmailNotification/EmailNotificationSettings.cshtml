@model TraineeTracker.Models.Dtos.NotificationSettingDto

@{
    ViewData["Title"] = "Notification Settings";
}

<link rel="stylesheet" href="~/css/notification_temp.css" />

<h2>@ViewData["Title"]</h2>

<form asp-action="SaveEmailNotificationSettingChange" method="post" class="notification-settings-form">

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveSkippedNotifications" />
            Notify when lesson is marked as "Skipped"
        </label>
    </div>

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveOpenNotifications" />
            Notify when lesson is marked as "Open"
        </label>
    </div>

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveStartedNotifications" />
            Notify when lesson is marked as "Started"
        </label>
    </div>

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveFinishedNotifications" />
            Notify when lesson is marked as "Finished"
        </label>
    </div>

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveRejectedNotifications" />
            Notify when lesson is marked as "Rejected"
        </label>
    </div>

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveAcceptedNotifications" />
            Notify when lesson is marked as"Accepted"
        </label>
    </div>

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveRatedNotifications" />
            Notify when lesson is marked as "Rated"
        </label>
    </div>

    <div>
        <label>
            <input type="checkbox" asp-for="ReceiveImportChangeNotifications" />
            Notify when teaching plan is updated
        </label>
    </div>

    <button type="submit">Save Settings</button>
</form>
