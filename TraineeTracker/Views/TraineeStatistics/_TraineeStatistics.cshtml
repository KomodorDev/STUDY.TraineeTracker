@using System.Text.Json
@using System.Globalization
@model TraineeTracker.Models.ViewModels.TraineeStatisticsViewModel

<div id="traineeStatisticsModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered sopro-lesson-modal-size" style="width: 100vw">
        <div class="modal-content sopro-card" style="box-shadow: none;">
            <div class="modal-header">
                <h5 class="modal-title header thiccboi">Extended Statistics</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body sopro-inner-card">

                <!-- Chart Container -->
                <div class="chart-container sopro-card">
                    <canvas id="lessonChart" style="border-radius: 11px;"></canvas>
                </div>

                <!-- Metric Tiles -->
                <div class="metrics-grid">
                    <div class="metric-tile sopro-card"><strong>SnapshotDate:</strong> @(Model.SnapshotDateTime.ToString("dd.MM.yyyy HH:mm"))</div>
                    <div class="metric-tile sopro-card"><strong>DaysPresentTotal:</strong> @(Model.DaysPresentTotal?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile sopro-card"><strong>DaysPresentTillToday:</strong> @(Model.DaysPresentTillToday?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile sopro-card"><strong>LessonDaysCompleted:</strong> @(Model.LessonDaysCompleted?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile sopro-card"><strong>LessonDaysOpen:</strong> @(Model.LessonDaysOpen?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile sopro-card"><strong>LessonDaysBuffer:</strong> @(Model.LessonDaysBuffer?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile sopro-card"><strong>Speed:</strong> @(Model.Speed?.ToString("0.00") ?? "N/A")</div>
                    <div class="metric-tile sopro-card"><strong>PredictedEstimatedEffortBuffer:</strong> @(Model.PredictedMissingEstimatedEffortAtEnd?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile sopro-card"><strong>PredictedActualDaysBuffer:</strong> @(Model.PredictedMissingActualDays?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile sopro-card">
                        <strong>Status:</strong>
                        @if (Model.IsUpToDate)
                        {
                            <span class="text-success">✔ Up to date</span>
                        }
                        else
                        {
                            <span class="text-danger">✘ Not up to date</span>
                        }
                    </div>
                </div>

                @if (Model.ProcessingPauses != null && Model.ProcessingPauses.Any())
                {
                    <div class="metric-tile sopro-card mt-3" style="width: 100%; padding: 1rem; min-height: auto; height: auto;">
                        <strong>Processing Pauses:</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var pause in Model.ProcessingPauses)
                            {
                                <li>
                                    @pause.StartDate.ToString("dd.MM.yyyy")
                                    –
                                    @pause.EndDate.ToString("dd.MM.yyyy")
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.AllLessons == null || !Model.AllLessons.Any())
                {
                    <div class="alert alert-warning">No lesson data available.</div>
                }
            </div>
        </div>
    </div>
</div>

@{
    var basePos = 0.0;
    var stackedLessons = Model.AllLessons.Select((l, index) => {
        var value = l.WeightedEffort > 0 ? l.WeightedEffort : l.EstimatedEffort;
        if (value <= 0) value = 0.1;
        var start = basePos;
        basePos += value;
        return new {
            Title = l.Title,
            Start = start,
            End = start + value,
            Status = l.Status
        };
    }).ToList();

    var chartData = stackedLessons.Select(l => new {
        x = new[] { l.Start, l.End },
        y = l.Title,
        status = l.Status
    });

    var colors = stackedLessons.Select(l =>
        l.Status == "open" ? "white" :
        l.Status == "started" ? "yellow" :
        l.Status == "finished" ? "#afafaf" :
        l.Status == "rejected" ? "#e61d47" :
        l.Status == "accepted" ? "#ffb199" :
        l.Status == "rated" ? "#626262" :
        "rgba(108, 117, 125, 0.8)"
    );

    var effortStart = basePos;
    var effortEnd = basePos + Model.PredictedMissingEstimatedEffortAtEnd.GetValueOrDefault();
    var effortOverlayMin = Math.Min(effortStart, effortEnd).ToString(CultureInfo.InvariantCulture);
    var effortOverlayMax = Math.Max(effortStart, effortEnd).ToString(CultureInfo.InvariantCulture);
}

<link rel="stylesheet" href="~/css/TraineeStatistics_temp.css" />

<script id="lessonChartConfigData" type="application/json">
@Html.Raw(JsonSerializer.Serialize(new {
    data = chartData,
    colors = colors,
    effortOverlayMin = effortOverlayMin,
    effortOverlayMax = effortOverlayMax,
    todayPos = Model.TodayPosition
}))
</script>