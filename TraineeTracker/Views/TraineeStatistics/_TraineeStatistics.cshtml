@using System.Text.Json
@using System.Globalization
@model TraineeTracker.Models.ViewModels.TraineeStatisticsViewModel

<div id="traineeStatisticsModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered sopro-lesson-modal-size" style="width: 100vw">
        <div class="modal-content sopro-card" style="box-shadow: none;">
            <div class="modal-header">
                <h5 class="modal-title">Statistics:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body sopro-inner-card">

                <!-- Chart Container -->
                <div class="chart-container">
                    <canvas id="lessonChart"></canvas>
                </div>

                <!-- Metric Tiles -->
                <div class="metrics-grid">
                    <div class="metric-tile"><strong>SnapshotDate:</strong> @(Model.SnapshotDateTime.ToString("dd.MM.yyyy HH:mm"))</div>
                    <div class="metric-tile"><strong>DaysPresentTotal:</strong> @(Model.DaysPresentTotal?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile"><strong>DaysPresentTillToday:</strong> @(Model.DaysPresentTillToday?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile"><strong>LessonDaysCompleted:</strong> @(Model.LessonDaysCompleted?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile"><strong>LessonDaysOpen:</strong> @(Model.LessonDaysOpen?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile"><strong>LessonDaysBuffer:</strong> @(Model.LessonDaysBuffer?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile"><strong>Speed:</strong> @(Model.Speed?.ToString("0.00") ?? "N/A")</div>
                    <div class="metric-tile"><strong>PredictedEstimatedEffortBuffer:</strong> @(Model.PredictedMissingEstimatedEffortAtEnd?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile"><strong>PredictedActualDaysBuffer:</strong> @(Model.PredictedMissingActualDays?.ToString("0.0") ?? "N/A")</div>
                    <div class="metric-tile">
                        <strong>Status:</strong>
                        @if (Model.IsUpToDate)
                        {
                            <span class="text-success">✔ Up to date</span>
                        }
                        else
                        {
                            <span class="text-danger">✘ Not up to date</span>
                        }
                    </div>
                </div>

                @if (!Model.AllLessons.Any())
                {
                    <div class="alert alert-warning">No lesson data available.</div>
                }
            </div>
        </div>
    </div>
</div>

@{
    var basePos = 0.0;
    var stackedLessons = Model.AllLessons.Select((l, index) => {
        var value = l.WeightedEffort > 0 ? l.WeightedEffort : l.EstimatedEffort;
        if (value <= 0) value = 0.1;
        var start = basePos;
        basePos += value;
        return new {
            Title = l.Title,
            Start = start,
            End = start + value,
            Status = l.Status
        };
    }).ToList();

    var chartData = stackedLessons.Select(l => new {
        x = new[] { l.Start, l.End },
        y = l.Title
    });

    var colors = stackedLessons.Select(l =>
        l.Status == "finished" ? "rgba(40, 167, 69, 0.8)" :
        l.Status == "accepted" ? "rgba(0, 123, 255, 0.8)" :
        l.Status == "rejected" ? "rgba(220, 53, 69, 0.8)" :
        l.Status == "started" ? "rgba(255, 193, 7, 0.8)" :
        "rgba(108, 117, 125, 0.8)"
    );

    var effortStart = basePos;
    var effortEnd = basePos + Model.PredictedMissingEstimatedEffortAtEnd.GetValueOrDefault();
    var effortOverlayMin = Math.Min(effortStart, effortEnd).ToString(CultureInfo.InvariantCulture);
    var effortOverlayMax = Math.Max(effortStart, effortEnd).ToString(CultureInfo.InvariantCulture);
}

<link rel="stylesheet" href="~/css/TraineeStatistics_temp.css" />

<script id="lessonChartConfigData" type="application/json">
@Html.Raw(JsonSerializer.Serialize(new {
    data = chartData,
    colors = colors,
    effortOverlayMin = effortOverlayMin,
    effortOverlayMax = effortOverlayMax,
    todayPos = Model.TodayPosition
}))
</script>