@* by blaskale & schleale with help from schwepau *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TraineeTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TraineeTracker.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

@*
change background: add
@{
    ViewData["BodyClass"] = "sopro-special-bg";
}

*@

<body class="@ViewData["BodyClass"]">
    <header>
        @if (IsSectionDefined("Navbar")) {
            @* redefine @section Navbar {<nav></nav>} to not use default nav bar *@
            <!-- no nav bar -->
            @RenderSection("Navbar", required: false)
        }
        else {
            <!-- default nav bar -->
            <nav class="navbar sopro-navbar navbar-expand-sm">
                <div class="container-fluid">
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @{
                                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                                
                            }
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" ? "active" : "text-dark")" asp-area="" asp-controller="Home" asp-action="Index">User</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "TraineeLessonDashboard" ? "active" : "text-dark")" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Feedback" ? "active" : "text-dark")" asp-area="" asp-controller="Feedback" asp-action="Index">Feedback</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "TeachingPlan" ? "active" : "text-dark")" asp-area="" asp-controller="Import" asp-action="Index">Import</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" ? "active" : "text-dark")" asp-area="" asp-controller="Admin" asp-action="ShowAdminDashboardView">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "EmailNotification" ? "active" : "text-dark")" asp-area="" asp-controller="Notifications" asp-action="Index">Settings</a>
                            </li>

                        </ul>

                        <!-- makandra logo -->
                        <a href="https://makandra.de/de" class="navbar-brand">
                            <img src="~/resources/makandra_logo_black.png" alt="logo" />
                        </a>
                    </div>
                </div>
            </nav>
        }
    </header>
    <!-- navbar end -->

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- here could be a footer -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
