@* by blaskale & schleale with help from schwepau *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TraineeTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* this breaks some stuff rn 
        <link rel="stylesheet" href="~/css/AdminDashboard_temp.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/EmailNotificationSettings_temp.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/FeedbackDashboard_temp.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/ImportDashboard_temp.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/TraineeLessonDashboard.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/TraineeLessonDetail.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/TraineeStatistics_temp.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/TraineeTracker.styles.css" asp-append-version="true" />
    *@
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">

    @RenderSection("Styles", required: false)
</head>

<body class="@ViewData["BodyClass"]">
    <header>
        @if (IsSectionDefined("Navbar")) {
            @* redefine @section Navbar {<nav></nav>} to not use default nav bar *@
            <!-- no nav bar -->
            @RenderSection("Navbar", required: false)
        }
        else {
            <!-- default nav bar -->
            <nav class="navbar sopro-navbar navbar-expand-sm">
                <div class="container-fluid">
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" style="overflow: hidden;">
                        <ul class="navbar-nav flex-grow-1">
                            @{
                                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            }
                            <!-- makandra logo -->
                            <a href="https://makandra.de/de" target="_blank" class="navbar-brand">
                                <img src="~/resources/makandra_logo_black.png" alt="logo" />
                            </a>

                            <!-- nav items -->
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "TraineeLessonDashboard" ? "active" : "text-dark")" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "EmailNotification" ? "active" : "text-dark")" asp-area="" asp-controller="Notifications" asp-action="Index">Settings</a>
                            </li>
                            @if (User.IsInRole("Mentor") || User.IsInRole("Admin")) {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Feedback" ? "active" : "text-dark")" asp-area="" asp-controller="Feedback" asp-action="Dashboard">Feedback</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "TeachingPlan" ? "active" : "text-dark")" asp-area="" asp-controller="TeachingPlan" asp-action="Dashboard">Import</a>
                                </li>
                            }
                            @if (User.IsInRole("Admin")) {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Admin" ? "active" : "text-dark")" asp-area="" asp-controller="Admin" asp-action="ShowAdminDashboardView">Admin</a>
                                </li>
                            }
                        </ul>
                        <!-- _LoginPartial -->
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        }
    </header>
    <!-- navbar end -->

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- here could be a footer -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@1.4.0/dist/chartjs-plugin-annotation.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
