@* by schleale *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TraineeTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TraineeTracker.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        @if (IsSectionDefined("Navbar")) {
            @* redefine @section Navbar {<nav></nav>} to not use default nav bar *@
            <!-- no nav bar -->
            @RenderSection("Navbar", required: false)
        }
        else {
            <!-- default nav bar -->
            <nav class="navbar sopro-navbar navbar-expand-sm sopro-drop-shadow">
                <div class="container-fluid">
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">User</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="FeedbackDashboard" asp-action="Index">Feedback</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ImportDashboard" asp-action="Index">Import</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="ShowAdminDashboardView">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="NotificationSettings" asp-action="Index">Notificationsettings</a>
                            </li>

                        </ul>

                        <!-- makandra logo -->
                        <a href="https://makandra.de/de" class="navbar-brand">
                            <img src="~/resources/makandra_logo_black.png" alt="logo" />
                        </a>
                    </div>
                </div>
            </nav>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @* we dont need a footer *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
