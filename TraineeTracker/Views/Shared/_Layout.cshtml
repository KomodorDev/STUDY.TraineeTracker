@* by schleale *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TraineeTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TraineeTracker.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        @if (IsSectionDefined("Navbar")) {
            @* redefine @section Navbar {<nav></nav>} to not use default nav bar *@
            <!-- no nav bar -->
            @RenderSection("Navbar", required: false)
        }
        else {
            <!-- default nav bar -->
            <nav class="navbar sopro-navbar navbar-expand-sm sopro-drop-shadow">
                <div class="container-fluid">
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">User</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Feedback</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Import</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Admin</a>
                            </li>
                        </ul>

                        <!-- makandra logo -->
                        <a href="https://makandra.de/de" class="navbar-brand">
                            <img src="~/resources/makandra_logo_black.png" alt="logo" />
                        </a>
                    </div>
                </div>
            </nav>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @* we dont need a footer *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <style>
        /* NAVBAR STYLING ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
        /* overall container */
        .navbar.sopro-navbar {
            /* !important overrides bootstrap */
            background-color: #ffffff !important;
            color: #000 !important;

            font-weight: bold;
            font-size: 1.406rem;

            height: 3.516rem !important;
            padding-left: 1.7rem !important;
            padding-right: 0 !important;
            display: flex;
            align-items: center;

            /* rounded bottom corners */
            border-bottom-left-radius: 15px !important;
            border-bottom-right-radius: 15px !important;
        }

        /* nav links container */
        .navbar.sopro-navbar .navbar-nav {
            display: flex;
            gap: 1.7rem !important;
        }

        /* menu items */
        .navbar.sopro-navbar .nav-link {
            color: #000 !important;
            font-weight: bold;
            font-size: 1.406rem;

            text-decoration: none !important;
            display: inline-block;
            position: relative;
        }

        /* logo/text on the left */
        .navbar.sopro-navbar .navbar-brand {
            color: #000 !important;
            font-weight: bold;
            font-size: 1.406rem;
            margin-right: 0.5rem;
        }

        /* makandra logo */
        .navbar-brand img {
            max-height: 2.6rem;
            height: auto;
            width: auto;
            vertical-align: middle;
        }

        nav.navbar .container-fluid {
            padding-right: 0 !important;
        }

        /* pseudo element, is the underline animaton */
        .nav-link::after {
            content: '';
            position: absolute;
            left: 50%;
            bottom: 3px;
            width: 0%;
            height: 2px; /* Thickness of the underline */
            background-color: black;
            border-radius: 15px;

            /* animation */
            transform: translateX(-50%);
            transition: width 0.3s ease-in-out;
        }

        .nav-link:hover::after {
            width: 100%;
        }

    </style>
</body>
</html>
