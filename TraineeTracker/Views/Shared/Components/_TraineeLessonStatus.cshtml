@* by schleale *@

@model string

@{
    var state = Model ?? "Error";
    string backgroundStyle = "green";
    string textColour = "#ffffff";

    switch (state) {
        case "Open":
            backgroundStyle = "background-color: #626262";
            break;
        case "Skipped":
            backgroundStyle = "background-color: #dbdbdb";
            break;
        case "Started":
            backgroundStyle = "background-color: #ffb199";
            break;
        case "Finished":
            backgroundStyle = "background-color: #fb6770";
            break;
        case "Rejected":
            backgroundStyle = "background-color: #e61d47";
            break;
        case "Accepted":
            backgroundStyle = "background-image: linear-gradient(to right, #e61d47, #ffb199)";
            break;
        case "Rated":
            backgroundStyle = "background-color: #dbdbdb";
            textColour = "#000000";
            break;
        default:
            break;
    };
}

<button style="width: 110px;
                height: 25px;
                border: none;
                cursor: default;
                border-radius: 15px;
                @backgroundStyle;
                color: @textColour;">
    @Model
</button>

