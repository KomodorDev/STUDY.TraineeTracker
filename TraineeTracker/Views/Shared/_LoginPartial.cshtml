@using Microsoft.AspNetCore.Identity
@using TraineeTracker.Models.Domain;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <!-- Manage settings -->
    <form asp-area="Identity" asp-page="/Account/Manage/Index">
        <button type="submit" class="btn btn-outline-dark mb-2">Hello @User.Identity?.Name!</button>
    </form>
    
    <!-- Logout button -->
    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="btn btn-outline-dark">Logout</button>
    </form>
}
else
{
    <!-- Register button -->
    <form asp-area="Identity" asp-page="/Account/Register" title="Manage">
        <button type="submit" class="btn btn-outline-dark mb-2">Register</button>
    </form>
    
    <!-- Login button -->
    <form class="form-inline" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="btn btn-outline-dark">Login</button>
    </form>
}
</ul>
