@model TraineeTracker.Models.ViewModels.TeachingPlanViewModels.TeachingPlanImportPreviewViewModel


<!-- Vertically centered scrollable modal -->
@* source: https://getbootstrap.com/docs/5.0/components/modal/ *@

<!-- modal header -->
<div class="modal-header header thiccboi" style="height: 75px;">
    <p class="modal-title">
        Teaching Plan Update – @Model.TeachingPlanName
    </p>
    <!-- close button X -->
    <button type="button" onclick="javascript:window.location.reload()" class="btn-close" data-bs-dismiss="modal"
        aria-label="Close"></button>
</div>
<!-- modal body-->
<div class="modal-body sopro-inner-card" style="padding-top: 9px; overflow-y: auto;">
    <div style="height: 125px;">
        <form asp-action="UpdatePreviewModal" asp-controller="TeachingPlan" method="post" enctype="multipart/form-data"
            class="stateChangeForm import-form" style="display: flex; flex-direction: column; gap: 1rem;">

            @Html.AntiForgeryToken()

            <input type="hidden" name="ExistingTeachingPlanId" value="@Model.TeachingPlanId" />

            <label for="NewPlanFile">Select updated JSON file:</label>
            <input type="file" name="NewPlanFile" required />

            <button type="submit" class="sopro-button-content" style="background-color: #FFB199;">
                Check Preview
            </button>
        </form>
    </div>

    @* Optional: List of changes *@
    @if (Model.NewActiveLessons.Any() || Model.NewInactiveLessons.Any() ||
        Model.ExistingReactivatedLessons.Any() || Model.ExistingDeactivatedLessons.Any() ||
        Model.AllImportedLessons.Any())
    {
        <hr />

        <div>
            @if (Model.NewActiveLessons.Any())
            {
                <p><strong>New Active Lessons:</strong></p>
                <ul>
                    @{
                        int index = 1;
                        foreach (var lesson in Model.NewActiveLessons)
                        {
                            var displayIndex = index.ToString("D3");
                            <li>
                                [@displayIndex] @lesson.Title (MakandraId: @lesson.Id)
                            </li>
                            index++;
                        }
                    }
                </ul>
            }

            @if (Model.NewInactiveLessons.Any())
            {
                <p><strong>New Inactive Lessons:</strong></p>
                <ul>
                    @{
                        int index = 1;
                        foreach (var lesson in Model.NewInactiveLessons)
                        {
                            var displayIndex = index.ToString("D3");
                            <li>
                                [@displayIndex] @lesson.Title (MakandraId: @lesson.Id)
                            </li>
                            index++;
                        }
                    }
                </ul>
            }

            @if (Model.ExistingReactivatedLessons.Any())
            {
                <p><strong>Existing Reactivated Lessons:</strong></p>
                <ul>
                    @{
                        int index = 1;
                        foreach (var lesson in Model.ExistingReactivatedLessons)
                        {
                            var displayIndex = index.ToString("D3");
                            <li>
                                [@displayIndex] @lesson.Title (MakandraId: @lesson.Id)
                            </li>
                            index++;
                        }
                    }
                </ul>
            }

            @if (Model.ExistingDeactivatedLessons.Any())
            {
                <p><strong>Existing Deactivated Lessons:</strong></p>
                <ul>
                    @{
                        int index = 1;
                        foreach (var lesson in Model.ExistingDeactivatedLessons)
                        {
                            var displayIndex = index.ToString("D3");
                            <li>
                                [@displayIndex] @lesson.Title (MakandraId: @lesson.Id)
                            </li>
                            index++;
                        }
                    }
                </ul>
            }

            @if (Model.AllImportedLessons.Any())
            {
                <p>
                    <strong>All Imported Lessons (in Imported Order):</strong><br />
                    <small style="color: gray;">
                        In case of duplicate MakandraIds, only the first occurrence in the import file is considered.
                    </small>
                </p>
                <ul>
                    @{
                        int index = 1;
                        @foreach (var lesson in Model.AllImportedLessons)
                        {
                            string displayIndex;
                            if (lesson.Deprecated)
                            {
                                displayIndex = "000";
                            }
                            else
                            {
                                displayIndex = index.ToString("D3");
                                index++;
                            }
                            <li>
                                [@displayIndex] @lesson.Title (MakandraId: @lesson.Id)
                                @if (lesson.Deprecated)
                                {
                                    <span style="color: gray;">(deprecated)</span>
                                }
                            </li>
                        }
                    }
                </ul>
            }

        </div>

        if (!Model.NewActiveLessons.Any() && !Model.NewInactiveLessons.Any() &&
        !Model.ExistingReactivatedLessons.Any() && !Model.ExistingDeactivatedLessons.Any())
        {
            <p style="text-align:center; margin-bottom:1rem;">
                No changes to the Teaching Plan detected. Only lesson data will be updated.
            </p>
        }

        <!-- Update Button -->
        <form asp-action="UpdateTeachingPlan" asp-controller="TeachingPlan" method="post" enctype="multipart/form-data"
            class="import-form" style="display: flex; flex-direction: column; gap: 1rem;">

            @Html.AntiForgeryToken()

            <input type="hidden" name="ExistingTeachingPlanId" value="@Model.TeachingPlanId" />
            <input type="hidden" name="TempFileName" value="@Model.TempFileName" />

            <button type="submit" class="sopro-button-content" style="background-color: #e61d47;">
                Confirm Update
            </button>
        </form>
    }
</div>