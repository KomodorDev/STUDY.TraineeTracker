@model TraineeTracker.Models.ViewModels.ImportDashboardViewModel

<h1>Import Dashboard</h1>

<!-- 1) Import-Form -->
<form asp-action="ImportNewTeachingPlan"
      method="post"
      enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <input asp-for="NewPlanName" />
  <span asp-validation-for="NewPlanName"></span>
  <input asp-for="NewPlanFile" type="file" />
  <span asp-validation-for="NewPlanFile"></span>
  <button type="submit">Importieren</button>
</form>

<hr />

<h2>Vorhandene Lehrpläne</h2>
<table>
  <thead>
    <tr>
      <th>Name</th><th>Last Updated</th><th>Lektionen</th><th>Azubis</th><th>Aktionen</th>
    </tr>
  </thead>
  <tbody>
  @foreach(var plan in Model.ExistingTeachingPlans)
  {
    <tr>
      <td>@plan.Name</td>
      <td>@plan.LastUpdated</td>
      <td>@plan.LessonCount</td>
      <td>@plan.TraineeCount</td>
      <td>
        <!-- Update -->
        <form asp-action="UpdateTeachingPlan"
              method="post"
              enctype="multipart/form-data" class="d-inline">
          @Html.AntiForgeryToken()
          <input type="hidden" name="teachingPlanId" value="@plan.TeachingPlanId" />
          <input type="file" name="file" required />
          <button type="submit">Update</button>
        </form>

        <!-- Delete -->
        <form asp-action="DeleteTeachingPlan"
              method="post" class="d-inline">
          @Html.AntiForgeryToken()
          <input type="hidden" name="teachingPlanId" value="@plan.TeachingPlanId" />
          <button type="submit"
                  onclick="return confirm('Löschen?');">
            Delete
          </button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table>

@section Scripts {
  @await Html.PartialAsync("_ValidationScriptsPartial")
}
