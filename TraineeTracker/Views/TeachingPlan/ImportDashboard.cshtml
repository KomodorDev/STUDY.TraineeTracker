@model TraineeTracker.Models.ViewModels.TeachingPlan.ImportDashboardViewModel
@{
    ViewData["Title"] = "Import Dashboard";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/css/ImportDashboard_temp.css?v=@DateTime.Now.Ticks" />

<div class="sopro-grid-management">
  <div class="sopro-card">
        <form asp-action="ImportNewTeachingPlan"
            asp-controller="TeachingPlan"
            method="post"
            enctype="multipart/form-data"
            class="import-form">
        @Html.AntiForgeryToken()
        <label for="NewPlanName">Import Teachingplan</label>
        <input type="text" name="NewPlanName" placeholder="Planname" required />
        <input type="file" name="NewPlanFile" required />
        <button type="submit" class="import-btn">Import</button>
        </form>
  </div>
  
  <div class="sopro-card">
      <div class="plan-list-container">
        @if (Model.ExistingTeachingPlans == null || !Model.ExistingTeachingPlans.Any())
        {
        <div class="no-plans">Keine Lehrpläne gefunden.</div>
        }
        else
        {
        @foreach (var plan in Model.ExistingTeachingPlans)
        {
          <div class="plan-box">
            <div class="plan-info">
                <h3 class="plan-name">@plan.Name</h3>
                <span class="plan-meta">Trainees: @plan.TraineeCount</span>
                <span class="plan-meta">Lektionen: @plan.LessonCount</span>
                <span class="plan-meta">Zuletzt: @plan.LastUpdated.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="plan-actions">
                <!-- Update -->
                <form asp-action="UpdateTeachingPlan" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ExistingTeachingPlanId" value="@plan.TeachingPlanId" />
                <input type="file" name="NewPlanFile" required />
                <button type="submit" class="update-btn">Update</button>
                </form>
                <!-- Delete -->
                <form asp-action="DeleteTeachingPlan" method="post" onsubmit="return confirm('Löschen?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="existingTeachingPlanId" value="@plan.TeachingPlanId" />
                <button type="submit" class="delete-btn">Löschen</button>
                </form>
            </div>
          </div>
        }
        }
    </div>
  </div>
</div>