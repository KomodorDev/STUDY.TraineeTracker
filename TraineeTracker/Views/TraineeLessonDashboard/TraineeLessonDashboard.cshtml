@* by schleale *@

@model TraineeTracker.Models.ViewModels.TraineeLessonDashboardViewModel
@using TraineeTracker.Models.Domain

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/TraineeLessonDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TraineeLessonDetail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TraineeStatistics_temp.css" asp-append-version="true" />
}

<button class="button open-button">Open Modal</button>
<div class="sopro-grid-lessons">
    <!-- Trainee + Statisticss -->
    <div class="sopro-grid-lessons-left">
        <!-- Trainee -->
        <section class="sopro-card small-header">
            <!-- Name -->
            <p class="header thiccboi">
                @(Model.SelectedTrainee?.UserName?.Split('@')[0] ?? "No trainee")
            </p>

            <!-- Teachinplan-->
            <div class="sopro-inner-card">
                <div class="header" style="font-size: 1.406rem;">
                    @(Model.SelectedTrainee?.TeachingPlan?.Name ?? "No teachingplan")
                </div>
            </div>
        </section>

        <!-- Statistics-->
        <section class="sopro-card small-header">
            <p class="header thiccboi">
                Statistics
            </p>
            <div class="sopro-inner-card flex">
                @{
                    var stats = Model.TraineeStatisticsSnapshot;
                }
                <p>Last update: just now</p>
                <p>
                    Present: @((stats?.DaysPresentTillToday ?? -999).ToString("0.0")) days
                </p>
                <p>
                    Open: @((stats?.LessonDaysOpen ?? -999).ToString("0.0")) days
                </p>
                <p>
                    Buffer: @((stats?.LessonDaysBuffer ?? -999).ToString("0.0")) days
                </p>
                @{
                    var speed = (stats?.Speed ?? -999).ToString("0.0");
                }
                <p>
                    Progression: @speed%
                </p>
                <div class="progress-bar bg-danger" role="progressbar" style="width: @speed%" aria-valuenow="50"
                    aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
        </section>
    </div>

    <!-- Selector + Lessons -->
    <section class="sopro-grid-lessons-right">
        <!-- Selector -->
        <div class="sopro-card">
            <div class="header thiccboi">
                Stuff to filter lessons
            </div>
        </div>

        <!-- Lessons -->
        <table class="sopro-card small-header">
            <thead class="header thiccboi">
                <tr class="sopro-table-format">
                    <th>Name</th>
                    <th>URL</th>
                    <th>Est.</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody class="sopro-inner-card flex">
                @foreach (var traineeLesson in (Model.TraineeLessons ?? throw new Exception("Empty Traineelesson ...somehow"))) {
                    <tr class="sopro-card sopro-table-format"
                        data-lesson-id="@traineeLesson.TraineeLessonId"     @* inserts id *@
                        data-bs-toggle="modal"                              @* click -> modal window *@
                        data-bs-target="#lessonDetailModal"                 @* points to modal with id lessonDetailModal *@
                        style="cursor: pointer;">                           @* mouse cursor when hovering *@
                        <td>@traineeLesson.Lesson.LessonId | @traineeLesson.Lesson.Title</td>
                        <td><a href="@traineeLesson.Lesson.LinkUrl" target="_blank">Link>></a></td>
                        <td>@traineeLesson.Lesson.EstimatedEffort days</td>
                        <td>
                            @{
                                var status = traineeLesson.State.ToString();
                                var color = status.ToLower();
                            }
                            <span class="sopro-tag @color">@status</span>
                        </td>
                    </tr>
                }
                <tr class="sopro-card sopro-table-format"><td>Lesson</td><td></td><td></td><td><span class="sopro-tag open">Status</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td><td></td><td></td><td><span class="sopro-tag skipped">Status</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td><td></td><td></td><td><span class="sopro-tag started">Status</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td><td></td><td></td><td><span class="sopro-tag finished">Status</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td><td></td><td></td><td><span class="sopro-tag rejected">Status</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td><td></td><td></td><td><span class="sopro-tag accepted">Status</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td><td></td><td></td><td><span class="sopro-tag rated">Status</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
                <tr class="sopro-card sopro-table-format"><td>Lesson</td></tr>
            </tbody>
        </table>
    </section>

    <!-- TraineeLessonDetail modal -->
    @await Html.PartialAsync("_TraineeLessonDetailModal")

    <!-- Bootstrap modal stuff, dont really understand 
    <div class="modal fade" id="lessonDetailModal" tabindex="-1" aria-labelledby="lessonDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="lessonDetailModalLabel">Lesson Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="lessonDetailModalBody">
                <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>-->
</div>

@section Scripts {
<script>
    @*document.addEventListener("DOMContentLoaded", function () {
        const rows = document.querySelectorAll(".lesson-row");

        rows.forEach(row => {
            row.addEventListener("click", function () {
                const lessonId = this.dataset.lessonId;
                const modalBody = document.getElementById("lessonDetailModalBody");

                modalBody.innerHTML = `
                    <div class="text-center p-5">
