@* by schleale *@

@model TraineeTracker.Models.ViewModels.TraineeLessonDashboardViewModel
@using TraineeTracker.Models.Domain

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/TraineeLessonDashboard.css" asp-append-version="true" />
}

<div class="sopro-grid-lessons">
    <!-- Trainee + Statisticss -->
    <div class="sopro-grid-lessons-left">
        <!-- Trainee -->
        <section class="sopro-card small-header">
            <!-- Name -->
            <p class="header thiccboi">
                @(Model.SelectedTrainee?.UserName?.Split('@')[0] ?? "No trainee")
            </p>

            <!-- Teachinplan-->
            <div class="sopro-inner-card">
                <div class="header" style="font-size: 1.406rem;">
                    @(Model.SelectedTrainee?.TeachingPlan?.Name ?? "No teachingplan")
                </div>
            </div>
        </section>

        <!-- Statistics-->
        <section class="sopro-card small-header">
            <p class="header thiccboi">
                Statistics
            </p>
            <div class="sopro-inner-card flex">
                @{
                    var stats = Model.TraineeStatisticsSnapshot;
                }
                <p>Last update: just now</p>
                <p>
                    Present: @((stats?.DaysPresentTillToday ?? -999).ToString("0.0")) days
                </p>
                <p>
                    Open: @((stats?.LessonDaysOpen ?? -999).ToString("0.0")) days
                </p>
                <p>
                    Buffer: @((stats?.LessonDaysBuffer ?? -999).ToString("0.0")) days
                </p>
                @{
                    var speed = (stats?.Speed ?? -999).ToString("0.0");
                }
                <p>
                    Progression: @speed%
                </p>
                <div class="progress-bar bg-danger" role="progressbar" style="width: @speed%" aria-valuenow="50"
                    aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
        </section>
    </div>

    <!-- Selector + Lessons -->
    <section class="sopro-grid-lessons-right">
        <!-- Selector -->
        <div class="sopro-card">
            <div class="header thiccboi">
                Stuff to filter lessons
            </div>
        </div>

        <!-- Lessons -->
        <div class="sopro-card small-header">
            <p class="header thiccboi">
                Lektionen
            </p>
            <div class="sopro-inner-card flex">
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
                <p class="sopro-card lesson">Lesson</p>
            </div>
        </div>
    </section>
</div>
