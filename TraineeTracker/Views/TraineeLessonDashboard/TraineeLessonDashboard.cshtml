@* by schleale *@

@model TraineeTracker.Models.ViewModels.TraineeLessonDashboardViewModel
@using TraineeTracker.Models.Domain

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/TraineeLessonDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TraineeLessonDetail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TraineeStatistics_temp.css" asp-append-version="true" />
}

<div class="sopro-grid-lessons">
    <!-- Trainee + Statisticss -->
    <div class="sopro-grid-lessons-left">
        <!-- Trainee -->
        <section class="sopro-card small-header">

            
            <!-- Name -->
            <div class="header thiccboi">
                <form method="get"
                    asp-action="ShowTraineeLessonDashboardView"
                    class="filter-selects"
                    style="display: flex; align-items: center;">

                    <!-- Nur Trainee Dropdown -->
                    <select name="traineeId" class="select-wide" onchange="this.form.submit()">
                        @foreach (var trainee in Model.Trainees ?? new List<ApplicationUser>())
                        {
                            <option value="@trainee.Id"
                                    selected="@(trainee.Id == Model.SelectedTrainee?.Id ? "selected" : null)">
                                @trainee.UserName!.Split('@')[0]
                            </option>
                        }
                    </select>

                    <!-- Filterzustand erhalten -->
                    <input type="hidden" name="filter" value="@Model.ActiveFilter" />
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                </form>
            </div>


            <!-- Teachinplan-->
            <div class="sopro-inner-card">
                <div class="header" style="font-size: 1.406rem;">
                    @(Model.SelectedTrainee?.TeachingPlan?.Name ?? "No teachingplan")
                </div>
            </div>
        </section>

        <!-- Statistics-->
        <section class="sopro-card small-header">
            <p class="header thiccboi">
                Statistics
            </p>
            <div class="sopro-inner-card flex">
                @{
                    var stats = Model.TraineeStatisticsSnapshot;
                }
                <p>Last update: just now</p>
                <p>
                    Present: @((stats?.DaysPresentTillToday ?? -999).ToString("0.0")) days
                </p>
                <p>
                    Open: @((stats?.LessonDaysOpen ?? -999).ToString("0.0")) days
                </p>
                <p>
                    Buffer: @((stats?.LessonDaysBuffer ?? -999).ToString("0.0")) days
                </p>
                @{
                    var speed = (stats?.Speed ?? -999).ToString("0.0");
                }
                <p>
                    Progression: @speed%
                </p>
                <div class="progress-bar bg-danger" role="progressbar" style="width: @speed%" aria-valuenow="50"
                    aria-valuemin="0" aria-valuemax="100">
                </div>
        
                <!-- Expand Button -->
                <button id="openStatisticsModalBtn"
                        class="btn sopro-button-content"
                        data-trainee-id="@Model.SelectedTrainee?.Id">
                    Show Extended Statistics
                </button>

            </div>
        </section>
    </div>

    <!-- Selector + Lessons -->
    <section class="sopro-grid-lessons-right">
        <!-- Selector -->
        <div class="sopro-card-filter">
            <div class="filter-bar">
                <a class="filter-tab @(Model.ActiveFilter == "all" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="all"
                asp-route-sortBy="@Model.SortBy">
                    All (@Model.CountAll)
                </a>

                <a class="filter-tab @(Model.ActiveFilter == "open" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="open"
                asp-route-sortBy="@Model.SortBy">
                    Open (@Model.CountOpen)
                </a>

                <a class="filter-tab @(Model.ActiveFilter == "started" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="started"
                asp-route-sortBy="@Model.SortBy">
                    Started (@Model.CountStarted)
                </a>

                <a class="filter-tab @(Model.ActiveFilter == "finished" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="finished"
                asp-route-sortBy="@Model.SortBy">
                    Finished (@Model.CountFinished)
                </a>

                <a class="filter-tab @(Model.ActiveFilter == "accepted" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="accepted"
                asp-route-sortBy="@Model.SortBy">
                    Accepted (@Model.CountAccepted)
                </a>

                <a class="filter-tab @(Model.ActiveFilter == "rejected" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="rejected"
                asp-route-sortBy="@Model.SortBy">
                    Rejected (@Model.CountRejected)
                </a>

                <a class="filter-tab @(Model.ActiveFilter == "rated" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="rated"
                asp-route-sortBy="@Model.SortBy">
                    Rated (@Model.CountRated)
                </a>

                <a class="filter-tab @(Model.ActiveFilter == "skipped" ? "active" : "")"
                asp-action="ShowTraineeLessonDashboardView"
                asp-route-traineeId="@Model.SelectedTrainee?.Id"
                asp-route-filter="skipped"
                asp-route-sortBy="@Model.SortBy">
                    Skipped (@Model.CountSkipped)
                </a>
            </div>

        </div>

        <!-- Lessons -->
        <table class="sopro-card small-header">
            <thead class="header thiccboi" style="border-bottom: 2px solid #e6e6e6;">
                <tr class="sopro-table-format">
                    <th>Name</th>
                    <th>URL</th>
                    <th>Est.</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody class="sopro-inner-card flex">
                @foreach (var traineeLesson in (Model.TraineeLessons ?? throw new Exception("Empty Traineelesson ...somehow"))) {
                    <tr class="sopro-card sopro-table-format"
                        data-lesson-id="@traineeLesson.TraineeLessonId">     @* the ID that is given to the modal *@
                        <td>@traineeLesson.Lesson.SortingIndex | @traineeLesson.Lesson.Title</td>
                        <td><a href="@traineeLesson.Lesson.LinkUrl" target="_blank">Link↗</a></td>
                        <td>@traineeLesson.Lesson.EstimatedEffort days</td>
                        <td>
                            @{
                                var status = traineeLesson.State.ToString();
                                var color = status.ToLower();
                            }
                            <span class="sopro-tag @color">@status</span>
                        </td>
                    </tr>
                }
                <tr class="sopro-card sopro-table-format"><td>This ia an open lesson</td><td></td><td></td><td><span class="sopro-tag open">Open</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>This ia a skipped lesson</td><td></td><td></td><td><span class="sopro-tag skipped">Skipped</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>This ia a started lesson</td><td></td><td></td><td><span class="sopro-tag started">Started</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>This ia a finished lesson</td><td></td><td></td><td><span class="sopro-tag finished">Finished</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>This ia a rejected lesson</td><td></td><td></td><td><span class="sopro-tag rejected">Rejected</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>This ia an accepted lesson</td><td></td><td></td><td><span class="sopro-tag accepted">Accepted</span></td></tr>
                <tr class="sopro-card sopro-table-format"><td>This ia a rated lesson</td><td></td><td></td><td><span class="sopro-tag rated">Rated</span></td></tr>
            </tbody>
        </table>
    </section>
</div>

<div id="lessonDetailModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered sopro-lesson-modal-size">
        <div class="modal-content sopro-card" id="TraineeLessonModalContent" style="box-shadow: none;">
        </div>
    </div>
</div>

<!-- usually, you would load the modal here, but we need extra data for the detailed view -->
<div id="modalPlaceholder"></div>


<!-- script for opening modal-->
@section Scripts {
    <script>
        /* open modal */
        document.querySelectorAll('tr[data-lesson-id]').forEach(row => {
            row.addEventListener('click', function () {
                const lessonId = this.getAttribute('data-lesson-id');

                // loading cursor
                document.body.style.cursor = 'wait';

                fetch(`/TraineeLessonDetail/${lessonId}`)
                    .then(response => response.text())
                    .then(html => {
                        // Inject response directly into existing modal content div
                        document.getElementById('TraineeLessonModalContent').innerHTML = html;

                        // Show the existing modal
                        const modalElement = document.getElementById('lessonDetailModal');
                        const modal = new bootstrap.Modal(modalElement);
                        modal.show();

                        // Hook up any dynamic event handlers inside the modal content
                        if (typeof window.hookUpStateChangeForms === 'function') {
                            window.hookUpStateChangeForms();
                        }
                    })
                    .catch(err => console.error("Failed to load modal", err))
                    .finally(() => {
                        // reset cursor
                        document.body.style.cursor = 'default';
                    });
            });
        });

        /* reload page after closing modal */
        const modalEl = document.getElementById('lessonDetailModal');

        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', () => {
                location.reload();
            });
        }
    </script>


    <script>
        const expandBtn = document.getElementById("openStatisticsModalBtn");
        if (expandBtn) {
        expandBtn.addEventListener("click", function () {
            const traineeId = this.dataset.traineeId;

            document.body.style.cursor = "wait";
            console.log("TraineeLessonDashboard - BROWSER:📦 traineeId:", traineeId);
            fetch(`/TraineeStatistics/${traineeId}`)
            .then(response => response.text())
            .then(html => {
                // Ganze Modalstruktur direkt in den Platzhalter schreiben
                document.getElementById("modalPlaceholder").innerHTML = html;


                // Modal aus dem neu geladenen HTML holen und anzeigen
                const modalEl = document.getElementById("traineeStatisticsModal");
                const modal = new bootstrap.Modal(modalEl);
                modal.show();

                // 🔍 Chart-Konfig lesen
                const configEl = document.getElementById("lessonChartConfigData");
                if (configEl) {
                    try {
                    const config = JSON.parse(configEl.textContent);
                    window.lessonChartConfig = config;
                    console.log("✅ lessonChartConfig geladen:", config);

                    if (typeof window.renderLessonChart === "function") {
                        window.renderLessonChart(config);
                    }
                    } catch (e) {
                    console.error("❌ Fehler beim Parsen der Chart-Konfiguration:", e);
                    }
                } else {
                    console.warn("⚠️ Kein lessonChartConfigData gefunden");
                }
                })
                .catch(err => {
                console.error("❌ Fehler beim Laden der Statistik-Modal:", err);
                })
                .finally(() => {
                document.body.style.cursor = "default";
                });
            });
        }
    </script>
}

