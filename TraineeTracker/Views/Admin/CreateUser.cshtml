@model TraineeTracker.Models.ViewModels.Admin.CreateUserViewModel;

@{
    ViewData["Title"] = "Create User";
}

<thead>
    <link rel="stylesheet" href="~/css/AdminDashboard_temp.css">
</thead>


<div class="sopro-grid-management" style="height: 100%">
    <div class="split-header flex">

        <!-- Header -->
        <div class="sopro-card" style="width: 100%">
            <div class="header thiccboi form">@ViewData["Title"]</div>
        </div>

        <!-- Back Button -->
        <div class="sopro-card flex">
            <div class="header">
                <a class="sopro-btn sopro-btn-prim sopro-button-header" asp-controller="Admin"
                    asp-action="Dashboard">Back</a>
            </div>
        </div>


    </div>

    <div class="sopro-card scroll">
        <form asp-action="CreateUser" method="post">
            <!-- Role selection (always visible) -->
            <div class="sopro-card small-header form">
                <div class="form-header">
                    <label asp-for="User.Role"></label>
                </div>
                <select asp-for="User.Role" class="sopro-inner-card form" aria-required="true" asp-items="Model.Roles"
                    onchange="this.form.submit()">
                    <option value="">Select role...</option>
                </select>
                <span asp-validation-for="User.Role" class="text-danger"></span>
            </div>

            @* Show the rest only if a role is selected *@
            @if (!string.IsNullOrEmpty(Model.User.Role))
            {
                <!-- Email is always shown -->
                <div class="sopro-card small-header form">
                    <div class="form-header">
                        <label asp-for="User.Email"></label>
                    </div>
                    <input asp-for="User.Email" type="email" required class="sopro-inner-card form" aria-required="true"
                        placeholder="firstname.lastname@makandra.de" />
                    <span asp-validation-for="User.Email" class="text-danger"></span>
                </div>

                @if (Model.User.Role == "Trainee")
                {
                    <div class="sopro-card small-header form">
                        <div class="form-header">
                            <label asp-for="User.TraineeStartDate"></label>
                        </div>
                        <input asp-for="User.TraineeStartDate" type="date" class="sopro-inner-card form" required="required" />
                        <span asp-validation-for="User.TraineeStartDate" class="text-danger"></span>
                    </div>

                    <div class="sopro-card small-header form">
                        <div class="form-header">
                            <label asp-for="User.TraineeEndDate"></label>
                        </div>
                        <input asp-for="User.TraineeEndDate" type="date" class="sopro-inner-card form" required="required" />
                        <span asp-validation-for="User.TraineeEndDate" class="text-danger"></span>
                    </div>

                    <div class="sopro-card small-header form">
                        <div class="form-header">
                            <label asp-for="User.TeachingPlanId"></label>
                        </div>
                        <select asp-for="User.TeachingPlanId" class="sopro-inner-card form" required="required"
                            asp-items="Model.TeachingPlans">
                            <option value="">Select Teachingplan...</option>
                        </select>
                        <span asp-validation-for="User.TeachingPlanId" class="text-danger"></span>
                    </div>
                }


                @* Form Buttons *@
                <div class="sopro-card form-buttons">

                    @* ConfirmSubmission: set to true ONLY when Create button is clicked *@
                    <input type="hidden" id="confirmSubmission" name="ConfirmSubmission" value="false" />

                    <button type="submit" class="sopro-btn sopro-btn-prim sopro-button-content"
                        onclick="document.getElementById('confirmSubmission').value = 'true'">
                        Create
                    </button>

                    <a asp-action="ShowAdminDashboardView" class="sopro-btn sopro-btn-sec sopro-button-content">
                        Cancel
                    </a>
                </div>
            }
        </form>
    </div>
</div>