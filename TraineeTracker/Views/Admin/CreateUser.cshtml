@model TraineeTracker.Models.ViewModels.Admin.CreateUserViewModel;

@{
    ViewData["Title"] = "Create User";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="CreateUser" method="post">
    <hr />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-group">
        <label asp-for="User.Email"></label>
        <input asp-for="User.Email" class="form-control" autocomplete="username" aria-required="true"
            placeholder="firstname.lastname@makandra.de" />
        <span asp-validation-for="User.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="User.Password"></label>
        <input asp-for="User.Password" type="password" class="form-control" autocomplete="new-password"
            aria-required="true" placeholder="Password" />
        <span asp-validation-for="User.Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="User.Role"></label>
        <select asp-for="User.Role" class="form-control" aria-required="true" asp-items="Model.Roles">
            <option value="">Select role...</option>
        </select>
        <span asp-validation-for="User.Role" class="text-danger"></span>
    </div>

    <!-- Optional for trainees -->
    <div class="form-group">
        <label asp-for="User.TraineeStartDate"></label>
        <input asp-for="User.TraineeStartDate" type="date" class="form-control" aria-required="true" />
        <span asp-validation-for="User.TraineeStartDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="User.TraineeEndDate"></label>
        <input asp-for="User.TraineeEndDate" type="date" class="form-control" aria-required="true" />
        <span asp-validation-for="User.TraineeEndDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="User.TeachingPlanId"></label>
        <select asp-for="User.TeachingPlanId" class="form-control" aria-required="true" asp-items="Model.TeachingPlans">
            <option value="">Select Teachingplan...</option>
        </select>
        <span asp-validation-for="User.TeachingPlanId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="ShowAdminDashboardView" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}