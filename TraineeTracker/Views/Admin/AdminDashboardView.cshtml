@model IEnumerable<TraineeTracker.Models.Domain.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
}

<link rel="stylesheet" href="~/css/AdminDashboardStyles.css">

<div class="grid-container">
    <div class="createUser">
        <a class="btn btn-primary" asp-controller="Admin" asp-action="ShowCreateUserView">Create</a>
    </div>
    <div class="filters">filters</div>
    <div class="users">
        <h3>Users</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Name</th>
                    <th>Startdate - Enddate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model) {
                    <tr>
                        <td>@user.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>