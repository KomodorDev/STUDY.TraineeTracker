@model TraineeTracker.Models.ViewModels.Admin.CreateProcessingPauseViewModel;

@{
    ViewData["Title"] = $"Create Processing Pause for {Model.UserName}";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="CreateProcessingPause" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="ProcessingPause.StartDate"></label>
        <input asp-for="ProcessingPause.StartDate" class="form-control" type="date" aria-required="true" />
        <span asp-validation-for="ProcessingPause.StartDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ProcessingPause.EndDate"></label>
        <input asp-for="ProcessingPause.EndDate" class="form-control" type="date" aria-required="true" />
        <span asp-validation-for="ProcessingPause.EndDate" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="ProcessingPause.TraineeId" />

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="ShowManageProcessingPausesView" asp-route-traineeId="@Model.ProcessingPause.TraineeId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}