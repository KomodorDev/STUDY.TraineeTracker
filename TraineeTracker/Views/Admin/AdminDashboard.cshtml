@model TraineeTracker.Models.ViewModels.Admin.AdminDashboardViewModel;

@{
    ViewData["Title"] = "Manage Users";
}

<link rel="stylesheet" href="~/css/AdminDashboard_temp.css">

<div class="grid-container">
    <div class="createUser">
        <a class="btn btn-primary" asp-controller="Admin" asp-action="ShowCreateUserView">Create User</a>
    </div>
    <div class="filters">filters</div>
    <div class="users">
        <h3>Users</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Name</th>
                    <th>Startdate - Enddate</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@Model.UserRoles[user.Id]</td>
                        <td>@user.Email</td>
                        @if (Model.UserRoles[user.Id] == "Trainee")
                        {
                            <td>@user.TraineeStartDate - @user.TraineeEndDate</td>
                            <td><a class="btn btn-primary" asp-action="ShowManageProcessingPausesView"
                                    asp-route-traineeId="@user.Id">Manage Processing Pauses</a></td>
                        }
                        else
                        {
                            <td></td>
                            <td></td>
                        }
                        @if (!user.IsClosed)
                        {
                            <td>
                                <form asp-action="CloseUser" asp-route-userId="@user.Id" method="post"
                                    onsubmit="return confirm('Are you sure you want to close @user.UserName? Processing Pauses, Teachingplans and Statistics will be lost. Feedbacks written by this user will remain preserved.');">
                                    <button type="submit" class="btn btn-danger">Close User</button>
                                </form>
                            </td>
                        }
                        else
                        {
                            <td>
                                <form asp-action="CloseUser" asp-route-userId="@user.Id" method="post">
                                    <button type="submit" class="btn btn-secondary" disabled>Closed</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>