@model TraineeTracker.Models.ViewModels.Admin.AdminDashboardViewModel;

@{
    ViewData["Title"] = "Manage Users";
}

<thead>
    <link rel="stylesheet" href="~/css/AdminDashboard_temp.css">
</thead>

<div class="sopro-grid-management">
    <div class="split-header flex">
        <div class="sopro-card-filter">
            Filter by
            <div class="filter-bar">
                <form asp-action="Dashboard" method="get" class="filter-tab filter-tab-select">
                    <select class="select-wide-filter" onchange="this.form.submit()">
                        <option>Role</option>
                        <option>Admin</option>
                        <option>Mentor</option>
                        <option>Trainee</option>
                    </select>
                </form>
                <form class="filter-tab filter-tab-select">
                    <select asp-action="Dashboard" method="get" class="select-wide-filter" onchange="this.form.submit()">
                        <option>Status</option>
                        <option>Open</option>
                        <option>Closed</option>
                    </select>
                </form>
                <form asp-action="Dashboard" method="get" class="filter-tab filter-tab-select">
                    <select class="select-wide-filter" onchange="this.form.submit()">
                        <option>Sort by</option>
                        <option>Name</option>
                        <option>Startdate</option>
                        <option>Enddate</option>
                    </select>
                </form>
            </div>
        </div>
        <div class="sopro-card flex">
            <div class="header">
                <a class="sopro-btn sopro-btn-prim sopro-button-header" asp-controller="Admin"
                    asp-action="ShowCreateUserView">Create User</a>
            </div>
        </div>
    </div>
    <div class="sopro-card scroll">
        <table class="table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Name</th>
                    <th>Startdate - Enddate</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@Model.UserRoles[user.Id]</td>
                        <td>@user.Email</td>
                        @if (Model.UserRoles[user.Id] == "Trainee")
                        {
                            <td>@user.TraineeStartDate - @user.TraineeEndDate</td>
                            <td><a class="sopro-btn sopro-btn-sec sopro-button-content"
                                    asp-action="ShowManageProcessingPausesView" asp-route-traineeId="@user.Id">Manage
                                    Processing
                                    Pauses</a></td>
                        }
                        else
                        {
                            <td></td>
                            <td></td>
                        }
                        @if (!user.IsClosed)
                        {
                            <td>
                                <form asp-action="CloseUser" asp-route-userId="@user.Id" method="post"
                                    onsubmit="return confirm('Are you sure you want to close @user.UserName? Processing Pauses, Teachingplans and Statistics will be lost. Feedbacks written by this user will remain preserved.');">
                                    <button type="submit" class="sopro-btn sopro-btn-prim sopro-button-content">Close
                                        User</button>
                                </form>
                            </td>
                        }
                        else
                        {
                            <td>
                                <form asp-action="CloseUser" asp-route-userId="@user.Id" method="post">
                                    <button type="submit" class="sopro-btn sopro-btn-dis sopro-button-content"
                                        disabled>Closed</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>