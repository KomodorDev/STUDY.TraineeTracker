@using TraineeTracker.Models.Domain
@model TraineeTracker.Models.Domain.ApplicationUser

@{
    ViewData["Title"] = $"Processing Pauses of {Model.UserName}";
}

<h2>@ViewData["Title"]</h2>

<a class="btn btn-primary" asp-action="CreateProcessingPause" asp-route-traineeId="Model.Id">Add Processing Pause</a>

<table class="table">
    <thead>
        <tr>
            <th>Start</th>
            <th>End</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pause in (IEnumerable<ProcessingPause>)ViewBag.Pauses) {
            <tr>
                <td>@pause.StartDate</td>
                <td>@pause.EndDate</td>
                <td>
                    <form asp-action="DeleteProcessingPause" asp-route-processingPauseId="@pause.ProcessingPauseId" method="post">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>