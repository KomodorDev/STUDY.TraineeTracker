@model TraineeTracker.Models.ViewModels.Admin.ManageProcessingPausesViewModel

@{
    ViewData["Title"] = $"Processing Pauses of {Model.UserName}";
}

<thead>
    <link rel="stylesheet" href="~/css/AdminDashboard_temp.css">
</thead>

<div class="sopro-grid-management" style="height: 100%">

    <div class="split-header flex">

        <!-- Header -->
        <div class="sopro-card flex-card">
            <div class="header thiccboi">
                <div class="smash">@ViewData["Title"]</div>
            </div>
        </div>

        <!-- Back Button -->
        <div class="sopro-card flex">
            <div class="header">
                <a class="sopro-btn sopro-btn-prim sopro-button-header" asp-controller="Admin"
                    asp-action="Dashboard">Back</a>
            </div>
        </div>

    </div>
    <div class="sopro-card scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Start</th>
                    <th>End</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>

                @foreach (var pause in Model.ProcessingPauses)
                {
                    // Bearbeitete Zeile erkennen
                    var isEditing = !ViewData.ModelState.IsValid &&
                    Context.Request.Form["ProcessingPauseId"] == pause.ProcessingPauseId.ToString();

                    if (isEditing)
                    {
                        <tr>
                            <td colspan="4">
                                <form asp-action="EditProcessingPause" method="post"
                                    style="display: flex; align-items: center; gap: 0.5rem; width: 100%;">
                                    <input type="hidden" name="ProcessingPauseId" value="@pause.ProcessingPauseId" />
                                    <input type="hidden" name="TraineeId" value="@Model.NewProcessingPause.TraineeId" />
                                    <input type="date" name="StartDate" value="@Context.Request.Form["StartDate"]" required
                                        class="sopro-inner-card form" style="flex: 1 1 0; min-width: 0;" />
                                    <input type="date" name="EndDate" value="@Context.Request.Form["EndDate"]" required
                                        class="sopro-inner-card form" style="flex: 1 1 0; min-width: 0;" />
                                    <button type="submit" class="sopro-btn sopro-btn-prim sopro-button-content"
                                        style="flex: 0 0 auto;">Save</button>
                                    <a href="@Url.Action("ShowManageProcessingPausesView", new { traineeId = Model.NewProcessingPause.TraineeId })"
                                        class="sopro-btn sopro-btn-dis sopro-button-content"
                                        style="flex: 0 0 auto; color: white;">Cancel</a>
                                </form>

                                <!-- 🔻 Hier kommt die Inline-Validation -->
                                <div class="text-danger" style="margin-top: 0.5rem;">
                                    @Html.ValidationSummary(false, "", new { @class = "text-danger", style = "margin: 0;" })
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr id="pause-row-@pause.ProcessingPauseId">
                            <td>@pause.StartDate.ToString("dd. MMMM yyyy")</td>
                            <td>@pause.EndDate.ToString("dd. MMMM yyyy")</td>
                            <td>
                                <button type="button" class="sopro-btn sopro-btn-sec sopro-button-content"
                                    onclick="editPause(@pause.ProcessingPauseId, '@pause.StartDate.ToString("yyyy-MM-dd")', '@pause.EndDate.ToString("yyyy-MM-dd")', '@Model.NewProcessingPause.TraineeId')">
                                    Edit
                                </button>
                            </td>
                            <td>
                                <form asp-action="DeleteProcessingPause" asp-route-processingPauseId="@pause.ProcessingPauseId"
                                    method="post"
                                    onsubmit="return confirm('Are you sure you want to delete this Processing Pause?');">
                                    <button type="submit" class="sopro-btn sopro-btn-prim sopro-button-content">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }

                @* CREATE NEW ROW *@
                <tr>
                    <form asp-action="CreateProcessingPause" method="post">
                        <td>
                            <input name="StartDate" type="date" class="sopro-inner-card form"
                                value="@Model.NewProcessingPause.StartDate.ToString("yyyy-MM-dd")" required />
                        </td>
                        <td>
                            <input name="EndDate" type="date" class="sopro-inner-card form"
                                value="@Model.NewProcessingPause.EndDate.ToString("yyyy-MM-dd")" required />
                        </td>

                        <td>
                            <input type="hidden" name="TraineeId" value="@Model.NewProcessingPause.TraineeId" />
                            <button type="submit" class="sopro-btn sopro-btn-prim sopro-button-content">
                                Create Processing Pause
                            </button>
                        </td>
                        <td></td>
                    </form>
                </tr>

                @if (!ViewData.ModelState.IsValid && !Context.Request.Form.ContainsKey("ProcessingPauseId"))
                {
                    <tr>
                        <td colspan="4">
                            <div class="text-danger" style="padding-top: 0.25rem;">
                                @Html.ValidationSummary(false, "", new {
                                @class = "text-danger", style = "margin: 0; padding: 0; list-style: none;"})
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function editPause(id, startDate, endDate, traineeId) {
        const row = document.getElementById(`pause-row-${id}`);
        row.innerHTML = `
        <td colspan="4">
        <form method="post" action="/Admin/EditProcessingPause" style="margin: 0; padding: 0;">
            <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%;">
            <input type="hidden" name="ProcessingPauseId" value="${id}" />
            <input type="hidden" name="TraineeId" value="${traineeId}" />
            <input type="date" name="StartDate" value="${startDate}" required
                class="sopro-inner-card form"
                style="flex: 1 1 0; min-width: 0;" />
            <input type="date" name="EndDate" value="${endDate}" required
                class="sopro-inner-card form"
                style="flex: 1 1 0; min-width: 0;" />
            <button type="submit"
                class="sopro-btn sopro-btn-prim sopro-button-content"
                style="flex: 0 0 auto;">Save</button>
            <button type="button"
                class="sopro-btn sopro-btn-dis sopro-button-content"
                onclick="location.reload()" style="flex: 0 0 auto;">Cancel</button>
            </div>
        </form>
        </td>
    `;
    }
</script>
