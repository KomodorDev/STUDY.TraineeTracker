# Top-most EditorConfig file
root = true

# Alle C#-Dateien
[*.cs]

##############################################
# Einrückung und Formatierung
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
end_of_line = lf
charset = utf-8

# Keine neue Zeile vor geschweifter Klammer, aber Leerzeichen davor
csharp_new_line_before_open_brace = none
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_call_name_and_open_parenthesis = false
csharp_space_between_parentheses = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_around_binary_operators = before_and_after
csharp_space_after_cast = false
csharp_space_after_unary_operators = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true

# if (...) { ... } else { ... } → kein Zeilenumbruch vor else
csharp_new_line_before_else = false

##############################################
# Namenskonventionen

# Private Felder (z. B. _lessonList)
dotnet_naming_rule.private_fields_should_be_camel_with_underscore.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_with_underscore.style = camel_with_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, internal, protected_internal
dotnet_naming_symbols.private_fields.required_modifiers = 

dotnet_naming_style.camel_with_underscore.capitalization = camel_case
dotnet_naming_style.camel_with_underscore.required_prefix = _
dotnet_naming_style.camel_with_underscore.required_suffix =

# Öffentliche Typen, Properties, Methoden → PascalCase
dotnet_naming_rule.public_members_should_be_pascal.severity = warning
dotnet_naming_rule.public_members_should_be_pascal.symbols = public_members
dotnet_naming_rule.public_members_should_be_pascal.style = pascal_case_style

dotnet_naming_symbols.public_members.applicable_kinds = property, method, field, class, struct, namespace, enum
dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_symbols.public_members.required_modifiers = 

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Lokale Variablen und Parameter → camelCase
dotnet_naming_rule.locals_and_parameters_should_be_camel.severity = suggestion
dotnet_naming_rule.locals_and_parameters_should_be_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_should_be_camel.style = camel_case_style

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *
dotnet_naming_symbols.locals_and_parameters.required_modifiers = 

dotnet_naming_style.camel_case_style.capitalization = camel_case

# Interfaces beginnen mit "I"
dotnet_naming_rule.interfaces_should_start_with_I.severity = warning
dotnet_naming_rule.interfaces_should_start_with_I.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_start_with_I.style = interface_prefix_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *
dotnet_naming_symbols.interface_symbols.required_modifiers = 

dotnet_naming_style.interface_prefix_style.capitalization = pascal_case
dotnet_naming_style.interface_prefix_style.required_prefix = I

##############################################
# Zeilenlänge und Argument-Wrapping

# Max. Zeilenlänge: 120
max_line_length = 120

# Statements umbrechen mit 4 Leerzeichen Einrückung
csharp_preserve_single_line_statements = false
